# pstack for Google Antigravity .gitignore

# Backups and archives generated by pstack-update
.backups/
*.tar.gz
*.tar
*.bak

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Operating System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary outputs and scratch
.cache/
tmp/
scratch/
.agents/

